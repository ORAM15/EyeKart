# ============================================================
# EYEKART — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Phase 6.1 Backend Foundation
# ============================================================

# Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# API Server Port
PORT=3001
HOST=127.0.0.1

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=eyekart_dev
DB_SSL=false

# Test Database Configuration
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5433
TEST_DB_USER=postgres
TEST_DB_PASSWORD=
TEST_DB_NAME=eyekart_test

# Session & Security Secrets
SESSION_SECRET=eyekart_dev_insecure_secret_replace_in_production_32chars!
COOKIE_SECRET=eyekart_cookie_dev_secret_replace_in_production!
SESSION_TTL_HOURS=24

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# ============================================================
# PHASE 6.6 EXTERNAL INTEGRATION CONFIGURATION
# ============================================================

# Safaricom M-PESA Daraja 2.0 Integration
# Values: 'DISABLED' | 'SANDBOX' | 'LIVE' (Defaults strictly to 'DISABLED')
MPESA_ENVIRONMENT=DISABLED
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=http://localhost:3001/api/webhooks/mpesa
MPESA_WEBHOOK_SECRET=

# Secure Object Storage Provider
# Values: 'LOCAL' | 'S3' (Defaults to 'LOCAL')
STORAGE_PROVIDER=LOCAL
STORAGE_UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Notification Provider
# Values: 'TEST' | 'AFRICASTALKING' (Defaults to 'TEST')
NOTIFICATION_PROVIDER=TEST
SMS_SENDER_ID=EyeKart

# Courier Logistics Provider
# Values: 'TEST' | 'FARGO' | 'G4S' (Defaults to 'TEST')
COURIER_PROVIDER=TEST

# Tax Fiscalization Provider
# Values: 'TEST' | 'ETIMS_VSCU' (Defaults to 'TEST')
TAX_PROVIDER=TEST
